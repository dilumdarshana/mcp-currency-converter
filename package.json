{
  "name": "@alcorme/mcp-currency-converter",
  "version": "1.1.0",
  "author": "Dilum Darshana <dilum.dar@gmail.com>",
  "description": "A Model Context Protocol (MCP) server for currency conversion, providing tools and resources for seamless integration.",
  "keywords": [
    "mcp",
    "currency-conversion",
    "model-context-protocol"
  ],
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dilumdarshana/mcp-currency-converter.git"
  },
  "bin": {
    "alcorme-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\" && esbuild src/serverless.ts --bundle --platform=node --format=esm --outfile=dist/serverless.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:watch": "tsc --watch",
    "build:dev": "tsx --watch src/index.ts",
    "mcp:stdio": "pnpm build && TRANSPORT=stdio node dist/index.js",
    "mcp:http": "pnpm build && TRANSPORT=http node dist/index.js",
    "inspector": "pnpm build && DANGEROUSLY_OMIT_AUTH=true mcp-inspector node dist/index.js",
    "inspector-http": "pnpm build && (TRANSPORT=http node dist/index.js &) && sleep 2 && DANGEROUSLY_OMIT_AUTH=true mcp-inspector http://localhost:3000/mcp",
    "semantic-release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
